<plan.ttl#plan> a plan:Plan;
    dct:title "RichEditor mentions <- full-text search (refactor first)";
    dct:description "Replace hard-coded items in RichEditor markdown mentions with label search over the search index, same as pos-navigation. Refactor the search-index ownership first, re-enable the mention extension afterwards.";
    plan:status plan:in-progress;
    dct:created "2026-10-09"^^xsd:date;
    dct:modified "2026-10-14T18:41:34Z"^^xsd:dateTime;
    plan:hasTask <#task-01-cache-search-index-in-core>, <#task-02-recreate-search-index-on-label-update>, <#task-03-remove-search-dom-events>, <#task-04-fix-cache-reference-invalidation>;
    plan:context <#entry-plan-context-01>, <#entry-plan-context-02>, <#entry-plan-context-03>;
    plan:decision <#entry-plan-decision-01>, <#entry-plan-decision-02>, <#entry-plan-decision-03>, <#entry-plan-decision-04>, <#entry-plan-decision-05>, <#entry-plan-decision-06>, <#entry-plan-decision-07>, <#entry-plan-decision-08>, <#entry-plan-decision-09>, <#entry-plan-decision-10>, <#entry-plan-decision-11>, <#entry-plan-decision-12>, <#entry-plan-decision-13>, <#entry-plan-decision-14>;
    plan:outOfScope <#entry-plan-outOfScope-01>;
    plan:option <#entry-plan-option-01>, <#entry-plan-option-02>, <#entry-plan-option-03>;
    plan:note <#entry-plan-note-01>, <#entry-plan-note-02>.

