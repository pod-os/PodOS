@prefix plan: <../plan-ontology.ttl#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<plan.ttl#plan> a plan:Plan;
    dct:title "RDF Metadata for Non-RDF Resources";
    dct:description "Users want to annotate non-RDF resources — such as PDF documents, images, or other binary files stored on a Solid Pod — with RDF metadata. Currently PodOS has no mechanism to attach structured, queryable data to resources that are not themselves RDF documents, making it impossible to describe, tag, or relate those resources within the Linked Data graph.";
    plan:status plan:draft;
    dct:created "2026-06-09"^^xsd:date;
    plan:hasTask <./rdf-metadata-for-non-rdf-resources.ttl#task-1-auto-follow-describedby>, <./rdf-metadata-for-non-rdf-resources.ttl#task-2-write-path-routing>, <./rdf-metadata-for-non-rdf-resources.ttl#task-3-integration-test>, <./rdf-metadata-for-non-rdf-resources.ttl#task-4-element-smoke-test>;
    plan:userStory "As a Pod owner, I want to attach a title and description to a PDF stored on my Pod, so that I can identify and search for it alongside my other linked data.", "As a Pod owner, I want to tag an image with RDF predicates (e.g. subject, date taken), so that I can browse and filter my photos by metadata.", "As a dashboard developer, I want pos-label and pos-value to work on binary resources the same way they work on RDF documents, so that I do not need to handle non-RDF resources specially in my markup.";
    plan:decision "Follow the Solid Protocol auxiliary resource mechanism: Link: rel=\"describedby\". The metadata document URL is server-assigned (CSS uses a .meta suffix, e.g. image.jpg.meta). PodOS does not hardcode any suffix convention.", "Auto-following rdfs:seeAlso blindly is unsafe (rdflib stores the Link header as rdfs:seeAlso, but hand-authored links also use that predicate). Auto-follow only the IANA link-relations/describedby predicate — pending upstream rdflib fix (linkeddata/rdflib.js#741).", "Keep enrichment transparent: Store.fetch() loads the .meta document into the store so callers, gateways and elements need no changes.", "Writes for binary-resource Things route to the .meta document (updater.editable(metaUrl)), not to the binary URI itself — a binary is not a valid SPARQL/RDF update target. Fail gracefully when no describedby link exists.";
    plan:openQuestion "When exactly does the rdflib describedby fix land, and do we vendor a patch in the meantime?", "Should PodOS ever create .meta documents for binaries that have none (write-new)? Deferred for now.";
    plan:note "Related: linkeddata/rdflib.js#741 (upstream rdflib bug to fix); docs/features/full-text-search.md (also relies on RDF labels attached to resources); ADR-0003 Handle data with rdflib.js; ADR-0016 RDFa alignment.";
    plan:outOfScope "Uploading or replacing binary file content (already handled by FileFetcher).", "Indexing metadata for full-text search (overlap noted, but separate feature).", "Supporting servers that do not implement auxiliary resources.", "Creating a .meta document for a binary that has none yet (write-new, not write-update; may be addressed in a follow-up).".
<./rdf-metadata-for-non-rdf-resources.ttl#task-1-auto-follow-describedby> a plan:Task;
    dct:title "Auto-follow describedby in Store.fetch (read path)";
    plan:parent <plan.ttl#plan>;
    plan:status plan:done;
    dct:created "2026-06-09"^^xsd:date;
    plan:goal "After Store.fetch(uri), automatically load any metadata document linked via rel=\"describedby\", so that the returned Thing for a binary resource is transparently enriched with its RDF metadata triples.";
    plan:scope "Change to Store.fetch() only. After the initial fetch, query the store for <uri> <http://www.iana.org/assignments/link-relations/describedby> ?metaUrl. If a ?metaUrl is found, call store.fetch(metaUrl) to load the metadata document into the store.", "No changes to elements, gateways, or other consumers — they already operate on Thing objects.";
    plan:verification "Fetch a binary resource (e.g. a PDF) from a CSS server that has a .meta document. Confirm the Thing returned by store.get(binaryUri) contains metadata triples (e.g. schema:description, dct:title).";
    plan:outOfScope "Write path (Task 2).", "Creating .meta documents that don't yet exist.";
    plan:note "Depends on: None (rdflib fix assumed upstream).".
<./rdf-metadata-for-non-rdf-resources.ttl#task-2-write-path-routing> a plan:Task;
    dct:title "Write-path routing for binary resources";
    plan:parent <plan.ttl#plan>;
    plan:status plan:done;
    dct:created "2026-06-09"^^xsd:date;
    plan:goal "When writing triples for a Thing whose URI is a binary resource, route writes to the metadata document (the describedby target) instead of to thing.uri.doc(), which would point to the binary itself — an invalid SPARQL/RDF update target.";
    plan:scope "Extend store.addPropertyValue() and/or the write layer to detect when the subject URI is a non-RDF resource.", "For binary resources, resolve the writable graph by following the describedby triple already in the store (loaded by Task 1 or a prior fetch).", "After Store.fetch() has loaded the .meta URL, updater.editable(metaUrl) returns true — writes can target that document.", "Must fail gracefully when no describedby link exists (i.e. no .meta document).";
    plan:verification "Fetch a binary resource so its .meta is in the store. Call store.addPropertyValue(thing, predicate, value) on the binary Thing. Confirm the triple is written to the .meta document, not to the binary URI. Confirm the write round-trips (re-fetch shows the new triple).";
    plan:outOfScope "Creating a .meta document for a binary that has none yet.", "Read path (Task 1).";
    plan:note "Depends on: None (parallel with Task 1).".
<./rdf-metadata-for-non-rdf-resources.ttl#task-3-integration-test> a plan:Task;
    dct:title "End-to-end integration test";
    plan:parent <plan.ttl#plan>;
    plan:status plan:done;
    dct:created "2026-06-09"^^xsd:date;
    plan:goal "Confirm the full round-trip works end-to-end: fetch a binary resource, verify metadata triples appear, write a new triple, verify it persists in the .meta document.";
    plan:scope "One integration test using Community Solid Server (which already serves .meta documents and rel=\"describedby\" headers).", "Test steps: 1. PUT a binary resource (e.g. test.pdf) and its .meta document to CSS. 2. Call Store.fetch(binaryUri) — verify metadata triples are loaded. 3. Call store.addPropertyValue() on the binary Thing — verify write succeeds. 4. Re-fetch or re-read the store — verify the new triple is present. 5. Optionally: verify the .meta document on the server contains the new triple.";
    plan:verification "Test passes green in CI.";
    plan:outOfScope "Element-level testing (Task 4).", "Servers that don't support auxiliary resources.";
    plan:note "Depends on Task 1 and Task 2.".
<./rdf-metadata-for-non-rdf-resources.ttl#task-4-element-smoke-test> a plan:Task;
    dct:title "Element smoke test";
    plan:parent <plan.ttl#plan>;
    plan:status plan:done;
    dct:created "2026-06-09"^^xsd:date;
    plan:goal "Verify that existing PodOS elements (pos-label, pos-value, pos-list, etc.) surface metadata for binary resources with zero code changes — confirming that the transparent enrichment from Task 1 is sufficient.";
    plan:scope "Load a page that renders a binary resource using existing PodOS elements. Confirm that labels (e.g. dct:title), descriptions, and other metadata from the .meta document render correctly.", "This is a validation step, not an implementation task — if it fails, the gap is in Task 1 or Task 2, not in the elements.";
    plan:verification "Manual or automated: render a binary resource's Thing via pos-label and pos-value, confirm metadata values appear.";
    plan:outOfScope "Any changes to element code.", "Write-path testing (covered by Task 3).";
    plan:note "Depends on Task 1.".
