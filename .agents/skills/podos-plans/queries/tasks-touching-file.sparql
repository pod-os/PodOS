PREFIX plan: <http://localhost:3000/dev/plans/plan-ontology.ttl#>
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema:<https://schema.org/>
PREFIX prov:  <http://www.w3.org/ns/prov#>

# Tasks touching a file (plan↔code impact). Replace <path fragment> with
# the path you care about before running.

SELECT (STRAFTER(STR(?task), "#task-") AS ?id)
  (GROUP_CONCAT(DISTINCT STRAFTER(STR(?dep), "#task-"); separator=", ") AS ?deps)
WHERE {
      ?task plan:touchesFile ?f .
    FILTER(CONTAINS(?f, "<path fragment>"))
    OPTIONAL { ?task plan:dependsOn ?dep . }
}
GROUP BY ?task
