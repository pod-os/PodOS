PREFIX plan: <http://localhost:3000/dev/plans/plan-ontology.ttl#>
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema:<https://schema.org/>
PREFIX prov:  <http://www.w3.org/ns/prov#>

# The currently active plan: title and status.
# Run with comunica-sparql over HTTP sources: active.ttl, plan-ontology.ttl,
# and the plan file(s) — see the podos-plans skill.

SELECT ?plan ?title ?status WHERE {
  ?active plan:active ?plan .
  ?plan dct:title ?title ; plan:status ?status .
}
