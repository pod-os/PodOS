PREFIX plan: <http://localhost:3000/dev/plans/plan-ontology.ttl#>
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema:<https://schema.org/>
PREFIX prov:  <http://www.w3.org/ns/prov#>

# What happened on a day (cross-plan journal). Replace <YYYY-MM-DD> with the
# date you care about. Add `dct:title ?title` on task and
# `OPTIONAL { ?entry prov:wasAttributedTo ?attr }` for authorship.

SELECT DISTINCT ?created ?task ?text
WHERE {
      ?task ?pred ?entry .
    ?entry schema:text ?text ; dct:created ?created .
    FILTER(STRSTARTS(STR(?created), "<YYYY-MM-DD>"))
}
ORDER BY ?created
