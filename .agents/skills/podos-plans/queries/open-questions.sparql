PREFIX plan: <http://localhost:3000/dev/plans/plan-ontology.ttl#>
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema:<https://schema.org/>
PREFIX prov:  <http://www.w3.org/ns/prov#>

# Open questions (should be empty for planned-through work — see the
# modelling rule in the skill: open questions are binary, open or gone).

SELECT ?task ?oq ?created WHERE {
      ?task plan:openQuestion ?entry .
    ?entry schema:text ?oq ; dct:created ?created .
}
ORDER BY DESC(?created)
