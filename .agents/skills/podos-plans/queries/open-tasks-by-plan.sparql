PREFIX plan: <http://localhost:3000/dev/plans/plan-ontology.ttl#>
PREFIX dct:   <http://purl.org/dc/terms/>
PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema:<https://schema.org/>
PREFIX prov:  <http://www.w3.org/ns/prov#>

# Open tasks by plan (board overview, including drafts; `plan:hasTask`
# needs `?plan` bound for ordering — join through `plan:parent`).
# Scopes to one graph when run against a single plan's graph.

SELECT (STRAFTER(STR(?task), "#task-") AS ?id) ?title ?state
  (GROUP_CONCAT(DISTINCT STRAFTER(STR(?dep), "#task-"); separator=", ") AS ?deps)
WHERE {
      ?task rdf:type plan:Task ; dct:title ?title ; plan:status ?status ;
          plan:parent ?plan .
    BIND(STRAFTER(STR(?status), "#") AS ?state)
    FILTER(?status IN (plan:draft, plan:planned, plan:in-progress))
    OPTIONAL { ?task plan:dependsOn ?dep . }
}
GROUP BY ?task ?state ?title ?plan ?status
ORDER BY ?plan ?task
