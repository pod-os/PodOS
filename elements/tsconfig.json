{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "declaration": false,
    "experimentalDecorators": true,
    "lib": ["dom", "es2023"],
    "types": ["./vitest/jest-dom.d.ts"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2017",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react",
    "jsxFactory": "h",
    "sourceMap": true,
    "skipLibCheck": true // https://github.com/ionic-team/ionicons/issues/1011#issuecomment-962038754
  },
  "include": ["src"]
}
